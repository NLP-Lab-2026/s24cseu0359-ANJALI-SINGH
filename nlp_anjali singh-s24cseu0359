    "# Teacher-style, step-by-step cleaning pipeline\n",
    "CONTRACTIONS = {\n",
    "    \"can't\": \"cannot\", \"it’s\": \"it is\", \"it's\": \"it is\", \"i’m\": \"i am\", \"i'm\": \"i am\",\n",
    "    \"i've\": \"i have\", \"u're\": \"you are\", \"c'mon\": \"come on\", \"did u\": \"did you\",\n",
    "    \"<3\": \"love\"\n",
    "}\n",
    "SPELLING = {\n",
    "    \"leanring\": \"learning\", \"spelng\": \"spelling\", \"evrythinggg\": \"everything\", \"evrything\": \"everything\",\n",
    "    \"waz\": \"was\", \"changin\": \"changing\", \"ppl\": \"people\", \"abt\": \"about\", \"sum\": \"some\",\n",
    "    \"lotsa\": \"lots of\", \"knw\": \"know\", \"thots\": \"thoughts\", \"cud\": \"could\", \"undrstnd\": \"understand\",\n",
    "    \"plz\": \"please\", \"n\": \"and\", \"mindblownn\": \"mindblown\", \"yaaayyyy\": \"yay\"\n",
    "}\n",
    "\n",
    "def clean_text_stepwise(text):\n",
    "    original = text\n",
    "    lowercase = original.lower()\n",
    "    for old, new in CONTRACTIONS.items():\n",
    "        lowercase = lowercase.replace(old, new)\n",
    "    urls_removed = re.sub(r\"(?:https?://|www\\.)\\S+\", \" \", lowercase)\n",
    "    special_removed = re.sub(r\"[^a-z0-9\\s]\", \" \", urls_removed)\n",
    "    repeated_reduced = re.sub(r\"([a-z])\\1{2,}\", r\"\\1\", special_removed)\n",
    "    punctuation_fixed = re.sub(r\"\\s+\", \" \", repeated_reduced).strip()\n",
    "    corrected = []\n",
    "    for word in punctuation_fixed.split():\n",
    "        replacement = SPELLING.get(word, word)\n",
    "        corrected.extend(replacement.split())\n",
    "    return {\n",
    "        \"Original Text\": original,\n",
    "        \"Lowercase\": lowercase,\n",
    "        \"URL Removed\": urls_removed,\n",
    "        \"Special Characters Removed\": special_removed,\n",
    "        \"Repeated Letters Reduced\": repeated_reduced,\n",
    "        \"Punctuation/Whitespace Normalized\": punctuation_fixed,\n",
    "        \"Final Cleaned Text\": \" \".join(corrected),\n",
    "    }\n",
    "\n",
    "cleaned_steps = [clean_text_stepwise(p) for p in paragraphs]\n",
    "for i, steps in enumerate(cleaned_steps, 1):\n",
    "    print(f\"Paragraph {i} — Final Cleaned Text:\\n{steps['Final Cleaned Text']}\\n\")\n",
