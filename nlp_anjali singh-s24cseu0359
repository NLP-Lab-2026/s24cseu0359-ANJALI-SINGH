    "# Download the genuine source dataset from UCI and inspect its properties\n",
    "IRIS_COLUMNS = [\"sepal_length\", \"sepal_width\", \"petal_length\", \"petal_width\", \"species\"]\n",
    "iris_response = download(SOURCES[\"uci_iris_csv\"])\n",
    "iris_response.raise_for_status()\n",
    "df = pd.read_csv(io.StringIO(iris_response.text), header=None, names=IRIS_COLUMNS).dropna()\n",
    "df[IRIS_COLUMNS[:4]] = df[IRIS_COLUMNS[:4]].astype(float)\n",
    "\n",
    "print(\"Source URL:\", SOURCES[\"uci_iris_csv\"])\n",
    "print(\"Rows:\", df.shape[0])\n",
    "print(\"Columns:\", df.shape[1])\n",
    "print(\"Dimensions:\", df.ndim)\n",
    "print(\"Approximate memory (bytes):\", int(df.memory_usage(deep=True).sum()))\n",
    "display(df.head())"
   ]
