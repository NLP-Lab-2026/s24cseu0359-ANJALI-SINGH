    "# Create and read representative tabular/interchange/data-file formats\n",
    "df.to_csv(DATA_DIR / \"iris.csv\", index=False)\n",
    "df.to_csv(DATA_DIR / \"iris.tsv\", sep=\"\\t\", index=False)\n",
    "df.to_excel(DATA_DIR / \"iris.xlsx\", index=False)\n",
    "df.to_json(DATA_DIR / \"iris.json\", orient=\"records\", indent=2)\n",
    "df.to_xml(DATA_DIR / \"iris.xml\", index=False, root_name=\"iris_data\", row_name=\"record\", parser=\"etree\")\n",
    "df.to_pickle(DATA_DIR / \"iris.pkl\")\n",
    "np.save(DATA_DIR / \"iris.npy\", df[IRIS_COLUMNS[:4]].to_numpy())\n",
    "np.savez(DATA_DIR / \"iris.npz\", features=df[IRIS_COLUMNS[:4]].to_numpy(), species=df[\"species\"].to_numpy())\n",
    "df.to_html(DATA_DIR / \"iris.html\", index=False)\n",
    "df.to_string(DATA_DIR / \"iris.txt\", index=False)\n",
    "\n",
    "# ARFF is a standard attribute-relation format; this file is also derived from UCI records.\n",
    "with open(DATA_DIR / \"iris.arff\", \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(\"@RELATION iris\\n\\n\")\n",
    "    for col in IRIS_COLUMNS[:4]: f.write(f\"@ATTRIBUTE {col} NUMERIC\\n\")\n",
    "    f.write(\"@ATTRIBUTE species {Iris-setosa,Iris-versicolor,Iris-virginica}\\n\\n@DATA\\n\")\n",
    "    df.to_csv(f, header=False, index=False)\n",
    "\n",
    "# SQL database and ZIP archive are also derived files.\n",
    "with sqlite3.connect(DATA_DIR / \"iris.sqlite\") as con:\n",
    "    df.to_sql(\"iris\", con, if_exists=\"replace\", index=False)\n",
    "with zipfile.ZipFile(DATA_DIR / \"iris_bundle.zip\", \"w\", zipfile.ZIP_DEFLATED) as zf:\n",
    "    for filename in [\"iris.csv\", \"iris.tsv\", \"iris.json\", \"iris.xml\", \"iris.xlsx\"]:\n",
    "        zf.write(DATA_DIR / filename, arcname=filename)\n",
    "\n",
    "loaded = {\n",
    "    \"CSV\": pd.read_csv(DATA_DIR / \"iris.csv\"),\n",
    "    \"TSV\": pd.read_csv(DATA_DIR / \"iris.tsv\", sep=\"\\t\"),\n",
    "    \"XLSX\": pd.read_excel(DATA_DIR / \"iris.xlsx\"),\n",
    "    \"JSON\": pd.read_json(DATA_DIR / \"iris.json\"),\n",
    "    \"XML\": pd.read_xml(DATA_DIR / \"iris.xml\", parser=\"etree\"),\n",
    "    \"PKL\": pd.read_pickle(DATA_DIR / \"iris.pkl\"),\n",
    "    \"NPY\": np.load(DATA_DIR / \"iris.npy\"),\n",
    "    \"NPZ\": np.load(DATA_DIR / \"iris.npz\", allow_pickle=True),\n",
    "    \"TXT\": (DATA_DIR / \"iris.txt\").read_text(encoding=\"utf-8\"),\n",
    "}\n",
